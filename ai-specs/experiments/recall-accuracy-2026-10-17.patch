+                })
+                .map_err(|e| map_sqlite_error(e, "graph triples"))?
+                .collect::<std::result::Result<Vec<_>, _>>()
+                .map_err(|e| map_sqlite_error(e, "graph triples"))?;
+            Ok(rows)
+        })
